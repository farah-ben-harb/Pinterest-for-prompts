{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",

    "strict": true,
    "noUncheckedIndexedAccess": true,

    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "verbatimModuleSyntax": true,

    "types": ["node"],
    "lib": ["ES2022", "DOM"],

    "skipLibCheck": true,
    "noEmit": true
  },
  "include": [
    "backend/**/*.ts",
    "frontend/**/*.ts",
    "tests/**/*.ts"
  ]
}